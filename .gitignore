# Variáveis de ambiente e segredos (nunca rastrear)
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.exemple
!.env.exemplo
!**/.env.example
!**/.env.exemple
!**/.env.exemplo

# Certificados privados e mídias de empresas
*.p12
*.pem
*.key
**/certificados/*.p12
**/certs/*.p12
frontend/public/company*/
backend/public/company*/

# Dependências e ambientes virtuais
node_modules/
**/node_modules/
venv/
**/venv/
.runtime/

# Logs e arquivos temporários
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
